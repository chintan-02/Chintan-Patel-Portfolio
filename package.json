{
  "name": "chintan-portfolio-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run generate:meta && npm run validate:meta",
    "generate:meta": "node scripts/generate-case-study-html.mjs",
    "validate:meta": "node scripts/validate-case-study-html.mjs",
    "preview": "vite preview",
